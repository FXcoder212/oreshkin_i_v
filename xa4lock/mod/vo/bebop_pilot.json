{
 "hero": "hero_bebop",
 "voice_description": "A cheerful middle-aged male voice, a garage robot built from old car parts. Speaks Russian with a warm, noticeable Armenian accent, lively and expressive, slightly gravelly, friendly and mischievous.",
 "lines": {
  "bebop_select_01_hero_3d": "Тётя Шушан меня собрала, и я её не подведу, клянусь карбюратором!",
  "bebop_select_02_hero_3d": "Ради тёти Шушан всё сделаю, ахпер.",
  "bebop_select_03_hero_3d": "Тётя Шушан — хороший человек, она бы не одобрила, что я дерусь за деньги. Но я робот из Гюмри, слушай. Совесть у меня давно на запчасти ушла. А драться весело!",
  "bebop_use_hook_01_ability_3d": "Крюк пошёл!",
  "bebop_use_hook_02_ability_3d": "Иди сюда, ахпер!",
  "bebop_use_hook_03_ability_3d": "Сейчас поймаю, джан!",
  "bebop_use_hook_04_ability_3d": "Запускаю руку!",
  "bebop_hook_lands_01_ability_3d": "Иди сюда, поговорим!",
  "bebop_hook_lands_02_ability_3d": "Ближе, ближе, не стесняйся, джан!",
  "bebop_hook_lands_03_ability_3d": "Куда собрался? Стой!",
  "bebop_use_power1_01_ability_3d": "Взлетай, джан!",
  "bebop_use_power1_02_ability_3d": "Спокойной ночи, дорогой!",
  "bebop_use_power3_01_ability_3d": "Тикает, слушай.",
  "bebop_use_power3_02_ability_3d": "Время у тебя в долг, ахпер.",
  "bebop_use_power4_01_ult_3d": "Фары «Нивы» включены!",
  "bebop_use_power4_02_ult_3d": "Даю дальний свет!",
  "bebop_use_power4_03_ult_3d": "Ну всё, гуляем!",
  "bebop_use_power4_04_ult_3d": "Сейчас нарежу, как бастурму!",
  "bebop_kill_anyhero_01_hero_3d": "Готов.",
  "bebop_kill_anyhero_02_hero_3d": "Ещё один, вай.",
  "bebop_kill_anyhero_03_hero_3d": "[laughs] Ха-ха-ха!",
  "bebop_kill_anyhero_04_hero_3d": "Обожаю это, джан!",
  "bebop_kill_viscous_01_hero_3d": "Возвращайся в холодильник, Мацуник!",
  "bebop_kill_viscous_02_hero_3d": "Мацуник скис!",
  "bebop_kill_atlas_01_hero_3d": "Извини, следователь-джан.",
  "bebop_kill_atlas_02_hero_3d": "Ты бы меня не остановил, Абрамян.",
  "bebop_close_call_01_hero_3d": "Чтобы меня сломать, надо больше стараться, слушай...",
  "bebop_close_call_02_hero_3d": "Вай, еле выкрутился...",
  "bebop_pick_up_gold_01_hero_3d": "О, души бесплатно, как на свадьбе...",
  "bebop_pick_up_gold_02_hero_3d": "Так-так, что тут у нас?",
  "bebop_happy_01_hero_3d": "Вот это хорошо, вай, как хорошо!",
  "bebop_happy_02_hero_3d": "Мне нравится, как идут дела...",
  "bebop_angry_08_hero_3d": "Давай, солнышко, шевелись!",
  "bebop_angry_09_hero_3d": "Я тут хоть весь день постою, ахпер.",
  "bebop_killstreak_start_01_hero_announcer": "Думаешь, я притормозлю? Плохие новости, джан...",
  "bebop_killstreak_start_02_hero_announcer": "Что такое, органики? Не успеваете за стариком Бебопяном?",
  "bebop_melee_kill_01_hero_3d": "Попался!",
  "bebop_melee_kill_02_hero_3d": "Всё, брат. Конец.",
  "bebop_ping_use_ability4_02_ping_2d": "Фары заряжены, готов светить!",
  "bebop_ping_use_ability4_03_ping_2d": "Дальний свет готов...",
  "bebop_congrats_01_hero_3d": "Вот как надо, джан!",
  "bebop_congrats_02_hero_3d": "Молодец, ахпер!",
  "bebop_sad_01_hero_3d": "Не верю, проигрываю органикам... вай...",
  "bebop_sad_02_hero_3d": "Стыдно, слушай, да?"
 },
